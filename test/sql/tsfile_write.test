require tsfile

statement ok
CREATE TABLE tsfile_write_source AS
SELECT * FROM (VALUES
    (1000::BIGINT, 'd1'::VARCHAR, TRUE, 7::INTEGER, 9::BIGINT, 1.25::FLOAT, 2.5::DOUBLE,
     'alpha'::VARCHAR),
    (1001::BIGINT, 'd1'::VARCHAR, FALSE, 8::INTEGER, NULL::BIGINT, 1.5::FLOAT, NULL::DOUBLE,
     NULL::VARCHAR),
    (1000::BIGINT, 'd2'::VARCHAR, TRUE, NULL::INTEGER, 11::BIGINT, 2.25::FLOAT, 3.5::DOUBLE,
     'beta'::VARCHAR)
) t(time, device_id, enabled, value_i, value_l, value_f, value_d, label);

statement ok
COPY (
    SELECT *
    FROM tsfile_write_source
    ORDER BY device_id, time
)
TO '__TEST_DIR__/tsfile_write_roundtrip.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    TIME_COLUMN time,
    TAG_COLUMNS (device_id)
);

query TTTTTTTT
SELECT typeof(time), typeof(device_id), typeof(enabled), typeof(value_i), typeof(value_l),
       typeof(value_f), typeof(value_d), typeof(label)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
LIMIT 1;
----
BIGINT	VARCHAR	BOOLEAN	INTEGER	BIGINT	FLOAT	DOUBLE	VARCHAR

query TTTTTTTT
SELECT CAST(time AS VARCHAR), device_id, CAST(enabled AS VARCHAR), CAST(value_i AS VARCHAR),
       CAST(value_l AS VARCHAR), CAST(value_f AS VARCHAR), CAST(value_d AS VARCHAR), label
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
ORDER BY device_id, time;
----
1000	d1	true	7	9	1.25	2.5	alpha
1001	d1	false	8	NULL	1.5	NULL	NULL
1000	d2	true	NULL	11	2.25	3.5	beta

# TAG equality is pushed into the TsFile device scan.
query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id = 'd1';
----
2

# TAG and time predicates are pushed together.
query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id = 'd1' AND time = 1001;
----
1

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE 'd1' = device_id AND 1000 <= time;
----
2

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id = 'missing';
----
0

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id != 'd1';
----
1

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id BETWEEN 'd1' AND 'd1';
----
2

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id = 'd1' OR device_id = 'd2';
----
3

query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE device_id IS NOT NULL;
----
3

# VARCHAR FIELD predicates remain in DuckDB and retain normal SQL semantics.
query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_roundtrip.tsfile', 'sensors')
WHERE label = 'alpha';
----
1

statement ok
COPY (
    SELECT i::BIGINT AS time,
           'device-' || CAST(i % 3 AS VARCHAR) AS device_id,
           (i * 2)::BIGINT AS value_l
    FROM range(5000) t(i)
    ORDER BY device_id, time
)
TO '__TEST_DIR__/tsfile_write_many.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    TAG_COLUMNS (device_id)
);

query III
SELECT count(*), min(time), max(time)
FROM read_tsfile('__TEST_DIR__/tsfile_write_many.tsfile', 'sensors');
----
5000	0	4999

statement error
COPY (
    SELECT 1::BIGINT AS time, 1::INTEGER AS device_id, 2.0::DOUBLE AS value
)
TO '__TEST_DIR__/tsfile_write_bad_tag.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    TAG_COLUMNS (device_id)
);
----
TsFile TAG column 'device_id' must have type VARCHAR

statement error
COPY (
    SELECT 1::BIGINT AS time, NULL::VARCHAR AS device_id, 2.0::DOUBLE AS value
)
TO '__TEST_DIR__/tsfile_write_null_tag.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    TAG_COLUMNS (device_id)
);
----
TsFile TAG column 'device_id' cannot contain NULL

# TIME_COLUMN and TAG_COLUMNS are matched case-insensitively, and the time
# column does not have to be the first input column.
statement ok
COPY (
    SELECT *
    FROM (VALUES
        ('east'::VARCHAR, 2002::BIGINT, 'device-1'::VARCHAR, 2.0::DOUBLE),
        ('west'::VARCHAR, 2000::BIGINT, 'device-1'::VARCHAR, NULL::DOUBLE),
        ('west'::VARCHAR, 2001::BIGINT, 'device-2'::VARCHAR, 1.0::DOUBLE)
    ) t(region, event_time, device_id, value)
    ORDER BY region, device_id, event_time
)
TO '__TEST_DIR__/tsfile_write_multiple_tags.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME multi_tag_sensors,
    TIME_COLUMN EVENT_TIME,
    TAG_COLUMNS (REGION, DEVICE_ID)
);

query TTT
SELECT CAST(time AS VARCHAR), region, device_id
FROM read_tsfile('__TEST_DIR__/tsfile_write_multiple_tags.tsfile', 'multi_tag_sensors')
ORDER BY region, device_id, time;
----
2002	east	device-1
2000	west	device-1
2001	west	device-2

# Predicates on multiple TAG columns are combined inside the TsFile scan.
query I
SELECT count(*)
FROM read_tsfile('__TEST_DIR__/tsfile_write_multiple_tags.tsfile', 'multi_tag_sensors')
WHERE region = 'west' AND device_id = 'device-2';
----
1

# Omitting TAG_COLUMNS creates a file with only FIELD columns.
statement ok
COPY (
    SELECT 3000::BIGINT AS time,
           'field-only'::VARCHAR AS message,
           42::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_without_tags.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME field_only
);

query TTT
SELECT CAST(time AS VARCHAR), message, CAST(value AS VARCHAR)
FROM read_tsfile('__TEST_DIR__/tsfile_write_without_tags.tsfile', 'field_only');
----
3000	field-only	42

# Timestamp values are mapped to TsFile TIMESTAMP fields.
statement ok
COPY (
    SELECT 4000::BIGINT AS time,
           TIMESTAMP '2024-10-20 12:34:56.123456'::TIMESTAMP_NS AS event_ts
)
TO '__TEST_DIR__/tsfile_write_timestamp.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME timestamp_fields
);

query II
SELECT typeof(event_ts), CAST(event_ts AS VARCHAR)
FROM read_tsfile('__TEST_DIR__/tsfile_write_timestamp.tsfile', 'timestamp_fields');
----
TIMESTAMP_NS	2024-10-20 12:34:56.123456

# DATE writing is rejected until the TsFile DATE conversion is timezone-safe.
statement error
COPY (
    SELECT 1::BIGINT AS time, DATE '2024-10-20' AS day
)
TO '__TEST_DIR__/tsfile_write_date.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME date_fields
);
----
TsFile COPY DATE columns are temporarily unsupported; use VARCHAR or INTEGER

statement error
COPY (
    SELECT 1::BIGINT AS time, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_missing_time.tsfile'
(
    FORMAT tsfile,
    TIME_COLUMN event_time
);
----
TIME_COLUMN 'event_time' was not found in the input

statement error
COPY (
    SELECT 1::INTEGER AS time, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_bad_time_type.tsfile'
(
    FORMAT tsfile
);
----
TsFile TIME_COLUMN 'time' must have type BIGINT in the first version

statement error
COPY (
    SELECT 1::BIGINT AS time, 'd1'::VARCHAR AS device_id, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_missing_tag.tsfile'
(
    FORMAT tsfile,
    TAG_COLUMNS (missing)
);
----
TAG_COLUMNS expected to find 'missing' in the input

statement error
COPY (
    SELECT 1::BIGINT AS time, 'd1'::VARCHAR AS device_id, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_duplicate_tag.tsfile'
(
    FORMAT tsfile,
    TAG_COLUMNS (device_id, DEVICE_ID)
);
----
TAG_COLUMNS contains duplicate column 'DEVICE_ID'

statement error
COPY (
    SELECT 1::BIGINT AS time, 'd1'::VARCHAR AS device_id, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_time_as_tag.tsfile'
(
    FORMAT tsfile,
    TAG_COLUMNS (time)
);
----
TIME_COLUMN cannot also be a TAG column

statement error
COPY (
    SELECT NULL::BIGINT AS time, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_null_time.tsfile'
(
    FORMAT tsfile
);
----
TsFile TIME_COLUMN 'time' cannot contain NULL

statement error
COPY (
    SELECT 1::BIGINT AS event_time, 2::INTEGER AS time, 3::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_time_name_conflict.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    TIME_COLUMN event_time
);
----
TsFile COPY reserves column name 'time' for the synthetic time axis

statement error
COPY (
    SELECT 1::BIGINT AS time, 2::INTEGER AS value
    WHERE false
)
TO '__TEST_DIR__/tsfile_write_empty.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors
);
----
TsFile COPY cannot write an empty result; at least one row is required

statement error
COPY (
    SELECT 2000::BIGINT AS time, 2::INTEGER AS value
)
TO '__TEST_DIR__/tsfile_write_roundtrip.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME sensors,
    OVERWRITE true,
    USE_TMP_FILE false
);
----
TsFile COPY cannot write directly to an existing path; omit USE_TMP_FILE false

# Embedded NUL bytes cannot be represented by the current TsFile tag-filter C
# API, so equality and BETWEEN stay in DuckDB instead of being pushed down.
statement ok
COPY (
    SELECT *
    FROM (VALUES
        (1::BIGINT, ('a' || chr(0) || 'b')::VARCHAR, 11::INTEGER),
        (2::BIGINT, 'a'::VARCHAR, 22::INTEGER)
    ) t(time, device_id, value)
    ORDER BY device_id, time
)
TO '__TEST_DIR__/tsfile_write_nul_tags.tsfile'
(
    FORMAT tsfile,
    TABLE_NAME nul_tags,
    TIME_COLUMN time,
    TAG_COLUMNS (device_id)
);

query I
SELECT value
FROM read_tsfile('__TEST_DIR__/tsfile_write_nul_tags.tsfile', 'nul_tags')
WHERE device_id = 'a' || chr(0) || 'b';
----
11

query I
SELECT value
FROM read_tsfile('__TEST_DIR__/tsfile_write_nul_tags.tsfile', 'nul_tags')
WHERE device_id BETWEEN ('a' || chr(0) || 'b') AND ('a' || chr(0) || 'b');
----
11
